{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "catalog-api/AGENTS.md",
    "catalog-collector/AGENTS.md",
    "catalog-ingester/AGENTS.md",
    "frontend/AGENTS.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["bunx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "qdrant": {
      "type": "local",
      "command": ["uvx", "--python", "3.12", "mcp-server-qdrant"],
      "enabled": true,
      "environment": {
        "QDRANT_URL": "{env:MOVIE_QDRANT_URL}",
        "QDRANT_API_KEY": "{env:MOVIE_QDRANT_API_KEY}",
        "COLLECTION_NAME": "{env:MOVIE_QDRANT_COLLECTION_NAME}",
        "EMBEDDING_PROVIDER": "fastembed",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      }
    },
    "postgres": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-postgres", "{env:MOVIE_DATABASE_URL}"],
      "enabled": true
    },
    "redis": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-redis", "{env:MOVIE_REDIS_URL}"],
      "enabled": true
    }
  }
}
