meta {
  name: remove from watchlist
  type: http
  seq: 3
}

delete {
  url: {{url}}/watchlist/:movieId
  body: none
  auth: inherit
}

params:path {
  movieId: 634649
}

docs {
  Requires authentication. Removes a movie from the signed-in user's watchlist. Removing a movie that isn't saved is a no-op.
}

settings {
  encodeUrl: true
  timeout: 0
}
