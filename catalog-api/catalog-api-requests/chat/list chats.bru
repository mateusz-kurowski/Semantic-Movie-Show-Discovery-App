meta {
  name: list chats
  type: http
  seq: 3
}

get {
  url: {{url}}/chat?limit={{chatsLimit}}&offset={{chatsOffset}}
  body: none
  auth: inherit
}

params:query {
  limit: {{chatsLimit}}
  offset: {{chatsOffset}}
}

docs {
  Requires authentication. Lists chats for the authenticated user, ordered by updatedAt desc. Query params: limit 1-100 (default 20), offset >=0 (default 0).
}

settings {
  encodeUrl: true
  timeout: 0
}
