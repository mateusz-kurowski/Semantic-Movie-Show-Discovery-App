meta {
  name: get chat by id
  type: http
  seq: 4
}

get {
  url: {{url}}/chat/:id
  body: none
  auth: inherit
}

params:path {
  id: replace-me
}

docs {
  Requires authentication. Fetches a single chat by ID including its messages ordered by createdAt asc. Replace `replace-me` with a real chat ID (cuid, e.g. cm1234567890abcdef). Returns 404 if not found or not owned by user.
}

settings {
  encodeUrl: true
  timeout: 0
}
