meta {
  name: get chat by id
  type: http
  seq: 4
}

get {
  url: {{url}}/chat/:id
  body: none
  auth: inherit
}

params:path {
  id: {{chatId}}
}

docs {
  Requires authentication. Fetches a single chat by ID including its messages ordered by createdAt asc. Set the `chatId` env var (`{{chatId}}`) to a real chat ID (cuid, e.g. cm1234567890abcdef) from create-chat. Returns 404 if not found or not owned by user.
}

settings {
  encodeUrl: true
  timeout: 0
}
