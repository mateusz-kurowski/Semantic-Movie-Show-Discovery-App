meta {
  name: delete chat
  type: http
  seq: 5
}

delete {
  url: {{url}}/chat/:id
  body: none
  auth: inherit
}

params:path {
  id: {{chatId}}
}

docs {
  Requires authentication. Deletes a chat by ID (cascades to messages). Set the `chatId` env var (`{{chatId}}`) to a real chat ID from create-chat. Returns 404 if not found or not owned by user.
}

settings {
  encodeUrl: true
  timeout: 0
}
