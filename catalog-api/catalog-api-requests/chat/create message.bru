meta {
  name: create message
  type: http
  seq: 6
}

post {
  url: {{url}}/chat/:id/messages
  body: json
  auth: inherit
}

params:path {
  id: {{chatId}}
}

body:json {
  {
    "role": "{{messageRole}}",
    "content": "{{messageContent}}"
  }
}

docs {
  Requires authentication. Creates a message in the specified chat. Params: id (chat ID — set the `chatId` env var to a real ID from create-chat). Body: role "user" | "assistant" | "system", content 1-10000 chars. Updates chat updatedAt on success.
}

settings {
  encodeUrl: true
  timeout: 0
}
