meta {
  name: get movies
  type: http
  seq: 1
}

get {
  url: {{url}}/movies?limit={{moviesLimit}}&sortBy={{moviesSortBy}}&order={{moviesOrder}}
  body: none
  auth: none
}

params:query {
  limit: {{moviesLimit}}
  sortBy: {{moviesSortBy}}
  order: {{moviesOrder}}
}

settings {
  encodeUrl: true
  timeout: 0
}
