# Credentials for the MCP servers declared in .mcp.json.
#
# .mcp.json only expands ${VAR} references that are already present in your shell
# environment — Claude Code does not load .env files on its own. Copy this file to
# .env.mcp, fill in the values, then `set -a && source .env.mcp && set +a` (or export
# them however you normally do) before launching `claude` in this repo.

# Brave Search MCP (web search for docs/library lookups) — https://brave.com/search/api/
BRAVE_API_KEY=

# Qdrant MCP (mcp-server-qdrant) — points at the same collection catalog-ingester
# writes and catalog-api searches. QDRANT_URL is the HTTP REST endpoint
# (e.g. http://192.168.55.113:6333) — distinct from the QDRANT_HOST/QDRANT_PORT
# gRPC pair used in catalog-api/.env and catalog-ingester's env.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=qa_movies

# Postgres MCP — same catalog DB catalog-api migrates and queries (see DATABASE_URL
# in catalog-api/.env.example for the connection string shape).
DATABASE_URL=

# Redis MCP — same instance catalog-api uses to cache query embeddings.
REDIS_URL=

# Playwright MCP (browser automation / screenshots) needs no credentials, but the
# frontend dev server must be running first: `cd frontend && bun run dev`.
