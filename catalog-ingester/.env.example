# Copy to .env.development.local (loaded when PRODUCTION != true)

# Postgres (shared with catalog-collector / catalog-api)
DATABASE_URL=postgresql://user:pass@localhost:5432/db

# Set to "true" to skip loading .env.development.local and use host env only
PRODUCTION=false

# Ingestion loop interval in seconds (0 = continuous)
INGEST_PERIOD_SECONDS=15
# Movies fetched per batch (falls back to 8 if invalid)
INGEST_BATCH_SIZE=8

# Qdrant (names and dimension must match catalog-api)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_SSL=false
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=movies
QDRANT_DENSE_VECTOR_NAME=overview-dense-vector
QDRANT_SPARSE_VECTOR_NAME=overview-sparse-vector
# Falls back to 256 if unset or <= 0
VECTOR_DIMENSION=256

# OpenAI-compatible embeddings endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_KEY=
# Must be consistent with VECTOR_DIMENSION; changing it invalidates cached embeddings
OPENAI_EMBEDDING_MODEL=voyage/voyage-4-lite

# Query-embedding cache
REDIS_URL=redis://localhost:6379
